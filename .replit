entrypoint = "src/index.ts"
modules = ["nodejs-20", "python-3.11", "postgresql-16"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-25_05"

[unitTest]
language = "nodejs"

[deployment]
run = ["bash", "-c", "npx tsx server/index.ts & npx tsx src/server.ts & wait"]
deploymentTarget = "vm"
ignorePorts = false
build = ["bash", "-c", "npx tsc --noEmit && npm --prefix client install && npm --prefix client run build"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[agent]
expertMode = true
integrations = ["javascript_database:1.0.0", "twilio:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Voice Agent Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Start Voice Agent Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx src/server.ts"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx server/index.ts"
waitForPort = 5000

[userenv]

[userenv.shared]
HUMAN_AGENT_NUMBER = "+16262229400"
URGENT_NOTIFICATION_NUMBER = "+16262229400"
PCP_TWILIO_PHONE_NUMBER = "+16269000771"
PCP_HUMAN_AGENT_NUMBER = "+17149564300"
DISABLE_PHI_LOGGING = "true"
# Shadow observer (approved 2026-08-02): observation-only capture on all active
# agents. Zero caller impact, zero n8n executions, no transcript storage, no
# model calls — all riskier flags stay at their off defaults (docs/voice-shadow-
# architecture/09). Emergency shutoff: set SHADOW_MODE_ENABLED = "false".
SHADOW_MODE_ENABLED = "true"
SHADOW_AGENT_ALLOWLIST = "no-ivr,dev-no-ivr,after-hours,answering-service,azul-scheduling,appointment-confirmation,drs-scheduler,fantasy-football"
SHADOW_CAPTURE_PCT = "100"
# Tiered reasoning models (GPT-5.6 family, verified 2026-08-02): Luna for
# routine turns, Terra for ambiguity/corrections, Sol for escalation-grade
# reasoning. Budget-capped: 6 calls/session, $5/day (SHADOW_MODEL_* to tune).
# DIRECTOR — the reasoning layer rules on live turns for these agents: it
# blocks a re-ask of a field the caller already answered, blocks bundled
# questions, and escalates past suggestion (authoring the turn, then forcing
# the exit) when the model ignores it. Deterministic, inline, sub-ms.
# after-hours + no-ivr added 2026-08-03 12:xx: two caller-ID name disclosures
# happened on no-ivr within the hour (12:35 greeted an unverified caller by
# name unprompted; 12:48 named the WRONG person to an outside pharmacy rep),
# and nothing was watching those lines.
# Instant disable: empty this list and republish.
DIRECTOR_AGENTS = "azul-scheduling,answering-service,no-ivr,after-hours"
SHADOW_MODEL_ROUTING_ENABLED = "true"
SHADOW_MODEL_LOW = "gpt-5.6-luna"
SHADOW_MODEL_MID = "gpt-5.6-terra"
SHADOW_MODEL_HIGH = "gpt-5.6-sol"
# Production realtime A/B — DISABLED 2026-08-03 after an operator-reported bad
# call following the first republish with the experiment live. Every call is
# back on the control model (gpt-realtime); unset AB_MODEL_B = no experiment
# anywhere, on any agent. Do not re-enable until the bad call is diagnosed and
# an arm-B test call is verified on a non-production number.
# AB_MODEL_B = "gpt-realtime-2.1"
# AB_MODEL_B_AGENTS = "azul-scheduling,answering-service,no-ivr"

[userenv.development]
DOMAIN = "dcf9f10f-5436-45b2-9ddd-3056216aaa94-00-3uh0nmdcvfbs6.spock.replit.dev"
APP_ENV = "development"

[userenv.production]
DOMAIN = "openai-realtime-api-voice-assistant-remix--fabianwayne1.replit.app"
APP_ENV = "production"
PORT = "5000"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
