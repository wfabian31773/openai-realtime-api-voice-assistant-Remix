# Fleet plugin API + SI Assistant. Blank values only — never commit a secret.

# Hub (already required). Apply migrations/add_plugin_api.sql separately.
DATABASE_URL=

# Master write switch. Defaults off. true / 1 / yes to enable prepare/commit.
PLUGIN_WRITES_ENABLED=

# Dedicated SI Assistant number (+1 909-255-3213). Voice URL must be
# https://<host>/voice/si-assistant before this campaign may dial.
SI_ASSISTANT_NUMBER=
OUTBOUND_CAMPAIGN_SI_ASSISTANT=
RUNTIME_OUTBOUND_DIALING=

# Ticketing-app callback webhook (HMAC X-SI-Assistant-Signature).
SI_ASSISTANT_CALLBACK_WEBHOOK_URL=
SI_ASSISTANT_CALLBACK_WEBHOOK_SECRET=

# Microsoft Graph, Entra app "SI Assistant Mail".
# SI_MAIL_CLIENT_ID in the live tenant is f9cdfde5-7685-42bc-a0dd-32e5c16bf4e3
# — set it in the deployment secret, do not hardcode it. Mailbox UPN is
# Support-Assistant@azulvision.com (Exchange RBAC for Applications, that
# mailbox only). Never put SI_MAIL_CLIENT_SECRET in git.
SI_ASSISTANT_EMAIL=
SI_MAIL_TENANT_ID=
SI_MAIL_CLIENT_ID=
SI_MAIL_CLIENT_SECRET=

# Twilio (SMS from SI_ASSISTANT_NUMBER; Messaging webhook
# /api/plugin/v1/webhooks/twilio-sms).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
