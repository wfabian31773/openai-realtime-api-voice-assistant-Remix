{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== MANDATORY CONTEXT — read before proposing anything ==='; cat CLAUDE.md; echo; echo '=== RUNNING STATE ==='; cat docs/observatory/STATE-OF-PLAY.md"
          }
        ]
      }
    ]
  }
}
